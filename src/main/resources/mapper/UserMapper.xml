<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.osj.dashboard.mapper.UserMapper">
    <resultMap id="userWithDepartment" type="com.osj.dashboard.dto.UserDTO">
        <id property="id" column="id" />
        <result property="nickname" column="nickname" />
        <result property="username" column="username" />
        <result property="password" column="password" />
        <result property="regDate" column="reg_date" />
        <result property="phoneNum" column="phone_num" />
        <result property="internalNum" column="internal_num" />
        <result property="email" column="email" />
        <result property="userRole" column="user_role" />
        <association property="departmentDTO" javaType="com.osj.dashboard.dto.DepartmentDTO">
            <id property="id" column="dep_id" />
            <result property="depName" column="dep_name" />
        </association>
    </resultMap>

    <select id="findByUserId" resultMap="userWithDepartment">
        SELECT *
        FROM user
        JOIN department d on user.dep_id = d.id
        WHERE username = #{username}
    </select>

    <insert id="insertUser" parameterType="com.osj.dashboard.dto.UserDTO">
        INSERT INTO User (nickname, username, password, reg_date, phone_num, internal_num, email, dep_id, user_role)
        VALUES (#{nickname}, #{username}, #{password}, #{regDate}, #{phoneNum}, #{internalNum}, #{email}, #{depId}, #{userRole});
    </insert>

    <select id="selectUser">
        SELECT * FROM user;
    </select>
</mapper>
